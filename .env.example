# Brevo API Configuration
# Get your API key from: https://app.brevo.com/settings/keys-smtp
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=your_verified_sender@example.com
RECIPIENT_EMAIL=your_recipient@example.com
# Optional: comma-separated list of CC recipients
CC_EMAILS=cc_one@example.com,cc_two@example.com
