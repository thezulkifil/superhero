# Brevo API Configuration
# Get your API key from: https://app.brevo.com/settings/keys-smtp
BREVO_API_KEY=your_brevo_api_key
SENDER_EMAIL=your_verified_sender@example.com
RECIPIENT_EMAIL=your_recipient@example.com
# Optional: comma-separated list of CC recipients
CC_EMAILS=cc_one@example.com,cc_two@example.com

# Relevance filtering (Groq)
# A small reasoning model decides which posts are actually about affordable
# eyewear. Without a key the bot filters nothing out and sends no posts.
# Get a free key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional: free plan allows 30 req/min, 1000 req/day, 8000 tokens/min.
RELEVANCE_MODEL=openai/gpt-oss-20b
# Optional: posts per model request, and how long to wait for a reply.
RELEVANCE_BATCH_SIZE=20
RELEVANCE_TIMEOUT_SECONDS=60
# Optional: cap generated tokens so one reply cannot eat the token budget.
RELEVANCE_MAX_TOKENS=1024
REASONING_EFFORT=low

# Optional: comma-separated overrides for the first-pass filter. Posts that match
# nothing here are never sent to the model, which keeps request usage down.
# Leave unset to use the built-in lists.
#
# KEYWORDS is the eyewear vocabulary. One hit admits a post on its own.
# AMBIENT_KEYWORDS are vague words (repair, cheap, durable) that only admit a
# post when two or more of them agree, so a lone "repair" in a toaster thread
# never reaches the model.
# KEYWORDS=glass,lens,frame,prescription,rx,coating,eye exam
# AMBIENT_KEYWORDS=repair,cheap,durable,bargain,worth it

# ---------------------------------------------------------------------------
# Guide topics (SEO / AEO)
#
# The superhero bot reads the questions out of the posts that survived the
# relevance filter, drops the duplicates, and emails the backlog once a day.
# The business bot does not do this: a lead is not something you publish.
#
# Questions go out after QUESTIONS_HOUR UTC, once per day. Everything not sent
# yet comes back tomorrow, so the list is a work queue rather than a daily
# trickle, and you can work through it at your own pace.
# ---------------------------------------------------------------------------
# QUESTIONS_HOUR=23
# Optional: who the guide list goes to. Defaults to RECIPIENT_EMAIL. This one is
# never cc'd, unlike the post digest, because the list is a work queue for
# whoever writes the articles rather than something to pass around.
# QUESTIONS_RECIPIENT_EMAIL=you@example.com
# Optional: use a different model for this pass. Defaults to the relevance model.
# QUESTIONS_MODEL=openai/gpt-oss-20b
# Optional: posts per model request, and how much of the body it may read. The
# question usually sits in the body rather than the title, so this is wider
# than the relevance pass.
# QUESTION_BATCH_SIZE=10
# QUESTIONS_MAX_TOKENS=1024

# Optional: where to keep the question backlog. Defaults to
# superhero_questions.json, placed on the Railway volume alongside the seen-ids
# file when there is one, so a redeploy does not wipe it.
# QUESTIONS_PATH=superhero_questions.json
# The backlog is a plain JSON file and is meant to be edited by hand. Clearing
# a question's "sent_on" puts it back on tomorrow's list, which is how a topic
# comes back around once you have written the guide.

# Optional: where to remember post ids across restarts. On Railway this is
# detected automatically from RAILWAY_VOLUME_MOUNT_PATH, so leave it unset.
# Do not set RAILWAY_VOLUME_MOUNT_PATH yourself, Railway overwrites it.
# SEEN_IDS_PATH=seen_ids.json

# ---------------------------------------------------------------------------
# Per-bot variables. Run one bot per service with --bot superhero or --bot
# business. Prefixed variables win for that bot, otherwise the shared name above
# is used, so a single-bot setup needs none of these.
# ---------------------------------------------------------------------------
# SUPERHERO_SEEN_IDS_PATH=superhero_seen_ids.json
# BUSINESS_SEEN_IDS_PATH=business_seen_ids.json
# SUPERHERO_RECIPIENT_EMAIL=you@example.com
# BUSINESS_RECIPIENT_EMAIL=leads@example.com
# SUPERHERO_INTERVAL=600
# BUSINESS_INTERVAL=1200
# SUPERHERO_KEYWORDS=glass,lens,prescription,rx
# BUSINESS_KEYWORDS=looking for,need,website,logo,seo
# BUSINESS_AMBIENT_KEYWORDS=small business,my store,client
# SUPERHERO_QUESTIONS_HOUR=23
